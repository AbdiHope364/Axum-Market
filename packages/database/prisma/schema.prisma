generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  passwordHash  String
  phone         String
  role          String    @default("SELLER") // SELLER, ADMIN
  status        String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED, REJECTED
  region        String?
  city          String?
  area          String?
  emailVerified Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  listings      Listing[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  breeds      Breed[]
  listings    Listing[]
}

model Breed {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings    Listing[]
}

model Location {
  id        String   @id @default(cuid())
  region    String
  city      String
  area      String?
  createdAt DateTime @default(now())
}

model Listing {
  id              String         @id @default(cuid())
  sellerId        String
  categoryId      String
  breedId         String?
  title           String
  description     String
  price           Float          // In ETB (Ethiopian Birr)
  age             String         // e.g. "4 years", "18 months"
  gender          String         // FEMALE, MALE
  region          String
  city            String
  area            String?
  contactPhone    String         // e.g. "+251911123456"
  status          String         @default("PENDING") // PENDING, ACTIVE, REJECTED, SOLD, REMOVED
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  seller          User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category        Category       @relation(fields: [categoryId], references: [id])
  breed           Breed?         @relation(fields: [breedId], references: [id])
  images          ListingImage[]
  reports         Report[]
}

model ListingImage {
  id          String   @id @default(cuid())
  listingId   String
  imageUrl    String
  imageType   String   // FRONT, LEFT, RIGHT
  createdAt   DateTime @default(now())

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Report {
  id               String   @id @default(cuid())
  listingId        String
  reason           String   // FAKE, WRONG_INFO, SUSPICIOUS, ALREADY_SOLD, DUPLICATE, OTHER
  description      String?
  reporterContact  String?
  status           String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt        DateTime @default(now())

  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

