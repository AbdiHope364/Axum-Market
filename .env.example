# AxumMarket Production Environment Variables
# Copy this file to .env or configure in your deployment dashboard (Vercel, Railway, Coolify, VPS, etc.)

# 1. Database Connection
# For local / VPS deployment with persistent storage:
DATABASE_URL="file:./packages/database/prisma/dev.db"
# For hosted PostgreSQL (Supabase, Neon, Railway Postgres, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/axummarket?schema=public"

# 2. Authentication Secret (Generate a 32+ char secure key)
# e.g. openssl rand -base64 32
JWT_SECRET="replace-with-a-very-strong-production-secret-key-32-chars"

# 3. Public Domain URLs
NEXT_PUBLIC_WEB_URL="https://axummarket.et"
NEXT_PUBLIC_ADMIN_URL="https://admin.axummarket.et"

# 4. Node Environment
NODE_ENV="production"

